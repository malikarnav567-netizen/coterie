# Veritas — copy to .env.local and adjust as needed.

# Supabase Postgres. DATABASE_URL = transaction pooler (port 6543) for the
# running app; DIRECT_URL = session pooler (port 5432) for schema pushes
# (prisma db push). Both come from Supabase → Connect. Percent-encode special
# characters in the password (%25 = %, %21 = !, %24 = $).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js secret (any long random string for local dev).
AUTH_SECRET="dev-secret-change-me-in-production"

# Set to "true" to let unverified accounts read the app while developing.
# It never grants posting/reviewing rights — those require an accepted sample.
DEV_BYPASS_VERIFICATION="false"

AUTH_URL="http://localhost:3000"
EMAIL_FROM="Coterie <no-reply@your-sending-mailbox.example>"

# Real email delivery for OTP codes (optional). With these set the app sends
# real mail; left empty it prints codes to the server console instead.
# Gmail example: enable 2-Step Verification, create an App Password, then
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<16-char app password>, EMAIL_FROM="Coterie <you@gmail.com>".
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
